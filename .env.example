# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ENVIRONMENT CONFIGURATION
NODE_ENV="development"
PORT="3000"

# INITIAL WARDEN PROVISIONING (Used to securely provision the initial Warden account in production)
INITIAL_WARDEN_EMAIL="warden@hostel.edu"
INITIAL_WARDEN_PASSWORD="YOUR_SECURE_WARDEN_PASSWORD"

# MYSQL DATABASE CONFIGURATION (Option A: Individual Parameters)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="hostel_user"
MYSQL_PASSWORD="HostelSecure#2026"
MYSQL_DATABASE="hostel_safety_db"
MYSQL_SSL="false"

# MYSQL DATABASE CONFIGURATION (Option B: Connection String URL - Common for Railway, Render, Aiven)
# DATABASE_URL="mysql://username:password@hostname:3306/dbname"
